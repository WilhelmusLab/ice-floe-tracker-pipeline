rule landmask_binarize:
    input:
        landmask="{date}.{scale}m.{satellite}/landmask.tiff",
        init="init-IFTP.txt"
    output:
        binarized="{date}.{scale}m.{satellite}/landmask.binarized.tiff",
        dilated="{date}.{scale}m.{satellite}/landmask.binarized.dilated.tiff"
    shell:
        "{config[IFT]} landmask_single "
        "-i {input.landmask} "
        "-o {output.binarized} "
        "-d {output.dilated}"

rule preprocess_lopez:
    input:
        truecolor="{date}.{scale}m.{satellite}/truecolor.tiff",
        falsecolor="{date}.{scale}m.{satellite}/falsecolor.tiff",
        landmask_binarized="{date}.{scale}m.{satellite}/landmask.binarized.tiff",
        landmask_dilated="{date}.{scale}m.{satellite}/landmask.binarized.dilated.tiff",
        init="init-IFTP.txt"
    output:
        labeled="{date}.{scale}m.{satellite}/labeled.lopez.tiff"
    shell:
        "{config[IFT]} preprocess_single "
        "-t {input.truecolor} "
        "-r {input.falsecolor} "
        "-l {input.landmask_binarized} "
        "-d {input.landmask_dilated} "
        "-o {output.labeled}"

rule preprocess_lopez_tiling:
    input:
        truecolor="{date}.{scale}m.{satellite}/truecolor.tiff",
        falsecolor="{date}.{scale}m.{satellite}/falsecolor.tiff",
        landmask_dilated="{date}.{scale}m.{satellite}/landmask.binarized.dilated.tiff",
        init="init-IFTP.txt"
    output:
        labeled="{date}.{scale}m.{satellite}/labeled.lopeztiling.tiff",
        segmented="{date}.{scale}m.{satellite}/segmented.lopeztiling.tiff"
    shell:
        "{config[IFT]} preprocess_tiling_single "
        "-t {input.truecolor} "
        "-r {input.falsecolor} "
        "-d {input.landmask_dilated} "
        "-l {output.labeled} "
        "-s {output.segmented} "
        "--tile-rblocks {config[TILE_RBLOCKS]} "
        "--tile-cblocks {config[TILE_CBLOCKS]} "
        "--ice-labels-prelim-threshold {config[ICE_LABELS_PRELIM_THRESHOLD]} "
        "--ice-labels-band-7-threshold {config[ICE_LABELS_BAND_7_THRESHOLD]} "
        "--ice-labels-band-2-threshold {config[ICE_LABELS_BAND_2_THRESHOLD]} "
        "--ice-labels-ratio-lower {config[ICE_LABELS_RATIO_LOWER]} "
        "--ice-labels-ratio-upper {config[ICE_LABELS_RATIO_UPPER]} "
        "--adapthisteq-white-threshold {config[ADAPTHISTEQ_WHITE_THRESHOLD]} "
        "--adapthisteq-entropy-threshold {config[ADAPTHISTEQ_ENTROPY_THRESHOLD]} "
        "--adapthisteq-white-fraction-threshold {config[ADAPTHISTEQ_WHITE_FRACTION_THRESHOLD]} "
        "--gamma {config[GAMMA]} "
        "--gamma-factor {config[GAMMA_FACTOR]} "
        "--gamma-threshold {config[GAMMA_THRESHOLD]} "
        "--unsharp-mask-radius {config[UNSHARP_MASK_RADIUS]} "
        "--unsharp-mask-amount {config[UNSHARP_MASK_AMOUNT]} "
        "--unsharp-mask-factor {config[UNSHARP_MASK_FACTOR]} "
        "--brighten-factor {config[BRIGHTEN_FACTOR]} "
        "--prelim-icemask-radius {config[PRELIM_ICEMASK_RADIUS]} "
        "--prelim-icemask-amount {config[PRELIM_ICEMASK_AMOUNT]} "
        "--prelim-icemask-factor {config[PRELIM_ICEMASK_FACTOR]} "
        "--icemask-band-7-threshold {config[ICEMASK_BAND_7_THRESHOLD]} "
        "--icemask-band-2-threshold {config[ICEMASK_BAND_2_THRESHOLD]} "
        "--icemask-band-1-threshold {config[ICEMASK_BAND_1_THRESHOLD]} "
        "--icemask-band-7-threshold-relaxed {config[ICEMASK_BAND_7_THRESHOLD_RELAXED]} "
        "--icemask-band-1-threshold-relaxed {config[ICEMASK_BAND_1_THRESHOLD_RELAXED]} "
        "--icemask-possible-ice-threshold {config[ICEMASK_POSSIBLE_ICE_THRESHOLD]} "
        "--icemask-n-clusters {config[ICEMASK_N_CLUSTERS]}"

rule preprocess_buckley:
    input:
        truecolor="{date}.{scale}m.{satellite}/truecolor.tiff",
        cloud="{date}.{scale}m.{satellite}/cloud.tiff",
        landmask="{date}.{scale}m.{satellite}/landmask.tiff",
        init="init-fsdproc.txt"
    output:
        labeled="{date}.{scale}m.{satellite}/labeled.buckley.tiff",
        props="{date}.{scale}m.{satellite}/labeled.buckley.props.csv"
    params:
        workdir="{date}.{scale}m.{satellite}/labeled.buckley.work"
    shell:
        "mkdir -p {params.workdir} && "
        "{config[FSDPROC]} process "
        "{input.truecolor} "
        "{input.cloud} "
        "{input.landmask} "
        "{params.workdir} "
        "--itmax {config[BUCKLEY_ITMAX]} "
        "--itmin {config[BUCKLEY_ITMIN]} "
        "--step {config[BUCKLEY_STEP]} "
        "--kernel-type {config[BUCKLEY_KERNEL_TYPE]} "
        "--kernel-size {config[BUCKLEY_KERNEL_SIZE]} && "
        "cp {params.workdir}/final.tif {output.labeled} && "
        "cp {params.workdir}/props.csv {output.props}"

# Main preprocess rule - selects method based on config
# Use ruleorder or explicit input function to select preprocessing method
def get_labeled_file(wildcards):
    preprocessing = config.get("PREPROCESSING", "Lopez")
    if preprocessing == "Lopez":
        return f"{wildcards.date}.{wildcards.scale}m.{wildcards.satellite}/labeled.lopez.tiff"
    elif preprocessing == "LopezTiling":
        return f"{wildcards.date}.{wildcards.scale}m.{wildcards.satellite}/labeled.lopeztiling.tiff"
    elif preprocessing == "Buckley":
        return f"{wildcards.date}.{wildcards.scale}m.{wildcards.satellite}/labeled.buckley.tiff"
    else:
        raise ValueError(f"Unknown PREPROCESSING method: {preprocessing}")

rule create_labeled_symlink:
    input:
        get_labeled_file
    output:
        "{date}.{scale}m.{satellite}/labeled.tiff"
    shell:
        "ln -sf $(basename {input}) {output}"

