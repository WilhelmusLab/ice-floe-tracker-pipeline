# ============================================================================
# EXPORT H5 RULE
# ============================================================================

rule export_h5:
    input:
        overpass="{date}.{scale}m.{satellite}/overpass.txt",
        truecolor="{date}.{scale}m.{satellite}/truecolor.tiff",
        falsecolor="{date}.{scale}m.{satellite}/falsecolor.tiff",
        labeled="{date}.{scale}m.{satellite}/labeled.tiff",
        props="{date}.{scale}m.{satellite}/labeled.props.csv",
        init="init-IFTP.txt"
    output:
        h5="{date}.{scale}m.{satellite}/results.h5"
    shell:
        "{config[IFT]} makeh5files_single "
        "--passtime \"$(cat {input.overpass} | tr -d '\\n\\r')\" "
        "--truecolor {input.truecolor} "
        "--falsecolor {input.falsecolor} "
        "--labeled {input.labeled} "
        "--props {input.props} "
        "--output {output.h5}"

# ============================================================================
# TRACKING RULE
# ============================================================================

def get_all_labeled_files(wildcards):
    return expand("{date}.{scale}m.{satellite}/labeled.tiff",
                  date=DATES, scale=config["SCALE"], satellite=SATELLITES)

def get_all_props_files(wildcards):
    return expand("{date}.{scale}m.{satellite}/labeled.props.csv",
                  date=DATES, scale=config["SCALE"], satellite=SATELLITES)

def get_all_landmask_files(wildcards):
    return expand("{date}.{scale}m.{satellite}/landmask.tiff",
                  date=DATES, scale=config["SCALE"], satellite=SATELLITES)

def get_all_overpass_files(wildcards):
    return expand("{date}.{scale}m.{satellite}/overpass.txt",
                  date=DATES, scale=config["SCALE"], satellite=SATELLITES)

rule tracking:
    input:
        labeled=get_all_labeled_files,
        props=get_all_props_files,
        landmasks=get_all_landmask_files,
        passtimes=get_all_overpass_files,
        init="init-IFTP.txt"
    output:
        tracked="floes.tracked.csv"
    params:
        dist=" ".join(map(str, config.get("TRACK_DIST", [15, 30]))),
        dt_thresh=" ".join(map(str, config.get("TRACK_DT_THRESH", [0, 1])))
    run:
        import subprocess
        
        # Build command
        labeled_files = " ".join(input.labeled)
        props_files = " ".join(input.props)
        landmask = input.landmasks[0]  # Use first landmask for latlon
        
        # Read all passtimes
        passtimes = []
        for pt_file in input.passtimes:
            with open(pt_file) as f:
                passtimes.append(f.read().strip())
        passtimes_str = " ".join(passtimes)
        
        cmd = (
            f"{config['IFT']} track_single "
            f"--imgs {labeled_files} "
            f"--props {props_files} "
            f"--latlon {landmask} "
            f"--passtimes {passtimes_str} "
            f"--output {output.tracked} "
            f"--dist {params.dist} "
            f"--dt-thresh {params.dt_thresh} "
            f"--Sminimumarea {config['TRACK_SMINIMUMAREA']} "
            f"--Sarearatio {config['TRACK_SAREARATIO']} "
            f"--Smajaxisratio {config['TRACK_SMAJAXISRATIO']} "
            f"--Sminaxisratio {config['TRACK_SMINAXISRATIO']} "
            f"--Sconvexarearatio {config['TRACK_SCONVEXAREARATIO']} "
            f"--Lminimumarea {config['TRACK_LMINIMUMAREA']} "
            f"--Larearatio {config['TRACK_LAREARATIO']} "
            f"--Lmajaxisratio {config['TRACK_LMAJAXISRATIO']} "
            f"--Lminaxisratio {config['TRACK_LMINAXISRATIO']} "
            f"--Lconvexarearatio {config['TRACK_LCONVEXAREARATIO']} "
            f"--mxrot {config['TRACK_MXROT']} "
            f"--psi {config['TRACK_PSI']} "
            f"--sz {config['TRACK_SZ']} "
            f"--comp {config['TRACK_COMP']} "
            f"--mm {config['TRACK_MM']} "
            f"--corr {config['TRACK_CORR']} "
            f"--large-floe-area {config['TRACK_LARGE_FLOE_AREA_MISMATCH_THRESHOLD']} "
            f"--small-floe-area {config['TRACK_SMALL_FLOE_AREA_MISMATCH_THRESHOLD']}"
        )
        shell(cmd)

# ============================================================================
# ROTATION RULE
# ============================================================================

rule get_rotation:
    input:
        tracked="floes.tracked.csv",
        overpass_times="overpass-times.csv",
        init_csvjoin="init-csvjoin.txt",
        init_ift="init-IFTP.txt"
    output:
        tracked_with_satellites="floes.tracked.satellite.csv",
        rotation="floes.tracked.rotation.csv"
    shell:
        "{config[CSVJOIN]} "
        "{input.tracked} passtime "
        "{input.overpass_times} 'overpass time' "
        "{output.tracked_with_satellites} "
        "--on-is-utc && "
        "{config[IFT]} measure_rotation "
        "-i {output.tracked_with_satellites} "
        "-o {output.rotation} "
        "-l {config[ROTATION_LOOKBACK_DAYS]}"

