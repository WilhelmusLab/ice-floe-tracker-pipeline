rule get_all_overpass_times:
    input:
        "init-soit.txt"
    output: 
        "overpass-times.csv"
    params:
        SPACEUSER=os.environ["SPACEUSER"],
        SPACEPSWD=os.environ["SPACEPSWD"]
    shell:
        "{config[PASS_TIME]} --csvoutpath {output} "
        "--startdate {config[START]} --enddate {config[END]} "
        "--centroid-lat {config[CENTROID_LAT]} --centroid-lon {config[CENTROID_LON]} "
        "--SPACEUSER {params.SPACEUSER} --SPACEPSWD {params.SPACEPSWD}"

rule get_single_overpass_time:
    input:
        "overpass-times.csv"
    output:
        "{date}.{scale}m.{satellite}/overpass.txt"
    run:
        import csv
        # Convert date format from YYYYMMDD to YYYY-MM-DD for matching
        date_with_dashes = f"{wildcards.date[:4]}-{wildcards.date[4:6]}-{wildcards.date[6:8]}"
        overpass_time = ""
        with open(input[0]) as f:
            csvfile = csv.reader(f)
            for row in csvfile:
                if row and row[0] == date_with_dashes and row[1] == wildcards.satellite:
                    overpass_time = row[2]
                    break
        with open(output[0], "w") as f:
            f.write(overpass_time + "\n")

